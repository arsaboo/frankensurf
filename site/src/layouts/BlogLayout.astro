---
// Shared shell for the blog: the landing page's nav, fonts and colours, with a reading column.
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import stitchedWaveMint from "../assets/stitched-wave-mint.svg?url";

const { frontmatter = {}, title: pageTitle, description: pageDescription } = Astro.props;
const title = frontmatter.title ?? pageTitle ?? "Blog";
const description = frontmatter.description ?? pageDescription ?? "Notes from building Frankensurf.";
const image = frontmatter.image ? new URL(frontmatter.image, Astro.site ?? Astro.url).href : undefined;
// "2026-10-09" (or a YAML date) → "9 October 2026"
const date = frontmatter.date
  ? new Date(frontmatter.date).toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
  : undefined;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} · Frankensurf</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={frontmatter.date ? "article" : "website"} />
  {image && <meta property="og:image" content={image} />}
  {image && <meta name="twitter:card" content="summary_large_image" />}
  <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon-stitched-wave.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
</head>
<body class="blog-page">
<a class="skip-link" href="#main">Skip to content</a>
<SiteNav />

<main id="main" class="post">
  {date && <p class="post-date">{date}</p>}
  {frontmatter.title && <h1>{frontmatter.title}</h1>}
  <slot />
</main>

<footer><span class="footer-brand"><img src={stitchedWaveMint} width="28" height="18" alt="" loading="lazy" />FRANKENSURF</span><span class="horror">It's alive.</span></footer>
</body>
</html>

<style is:global>
  .post { max-width: 720px; margin-inline: auto; padding: 140px 24px 96px; font: 18px/1.7 var(--sans); color: var(--fg-2); }
  .post h1 { font: 600 clamp(34px, 6vw, 52px)/1.1 var(--sans); letter-spacing: -0.03em; color: var(--fg); margin: 0 0 40px; }
  .post h2 { font: 600 28px/1.25 var(--sans); letter-spacing: -0.02em; color: var(--fg); margin: 56px 0 16px; }
  .post p { margin: 0 0 20px; }
  .post a { color: var(--accent); }
  .post strong { color: var(--fg); }
  .post img { display: block; width: 100%; height: auto; margin: 32px 0; border-radius: 14px; border: 1px solid var(--line); }
  .post table { width: 100%; border-collapse: collapse; margin: 28px 0; font: 15px/1.4 var(--mono); }
  .post th, .post td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--line-2); }
  .post th { color: var(--fg); font-weight: 600; }
  .post td:not(:first-child), .post th:not(:first-child) { text-align: right; }
  .post code { font: 0.9em var(--mono); color: var(--fg); background: rgba(255, 255, 255, 0.06); padding: 2px 6px; border-radius: 6px; }
  .post-date { font: 13px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 0 0 14px; }
  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-list li { padding: 24px 0; border-bottom: 1px solid var(--line); }
  .post-list a { font: 600 24px/1.3 var(--sans); color: var(--fg); text-decoration: none; }
  .post-list a:hover { color: var(--accent); }
  .post-list p { margin: 8px 0 0; color: var(--muted); }
  @media (max-width: 600px) { .post { padding-top: 110px; font-size: 17px; } .post table { font-size: 13px; } }
</style>
