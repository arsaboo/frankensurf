<script>
  // The snake plays reads in turn: a dot travels the path, stopping at each tool
  // the read tries (red with the reason, or green where it gets the page), the
  // path behind it lights up, and the caption gives the receipt. Only while on
  // screen; with reduced motion it shows one finished read.
  (() => {
    const fig = document.querySelector<HTMLElement>("[data-snake]");
    if (!fig) return;
    const reads = [
      { url: "docs.python.org/3/library/asyncio.html", steps: [["http", "ok", "markdown served"]], result: "the page via plain HTTP · 1 tried · free" },
      { url: "app.example.com/dashboard", steps: [["http", "fail", "empty JS shell"], ["jina", "ok", "rendered"]], result: "the page via Jina Reader · 2 tried · free" },
      { url: "walmart.com/search?q=air+fryer", steps: [["http", "fail", "CAPTCHA"], ["local", "fail", "CAPTCHA"], ["camoufox", "ok", "107 results"]], result: "the page via Camoufox · 3 tried · free" },
      { url: "crunchbase.com/organization/…", steps: [["http", "fail", "blocked"], ["local", "fail", "blocked"], ["camoufox", "fail", "blocked"], ["scrapling", "fail", "blocked"], ["firecrawl", "ok", "got through"]], result: "the page via Firecrawl · 5 tried · $0.004" },
      { url: "mybank.example/statements", steps: [["local", "fail", "2FA prompt"], ["you", "ok", "you approve it"]], result: "the page, after you cleared 2FA · read carries on" },
    ];
    const urlEl = fig.querySelector<HTMLElement>("[data-snake-url]")!;
    const resultEl = fig.querySelector<HTMLElement>("[data-snake-result]")!;
    const visible = () => [...fig.querySelectorAll<SVGSVGElement>(".snake-svg")].find((svg) => svg.getBoundingClientRect().width > 0);
    const geometry = new Map<SVGSVGElement, { path: SVGPathElement; total: number; at: Record<string, number> }>();
    const measure = (svg: SVGSVGElement) => {
      if (geometry.has(svg)) return geometry.get(svg)!;
      const path = svg.querySelector<SVGPathElement>(".snake-path")!;
      const total = path.getTotalLength();
      // Where each node sits along the path: one coarse pass over the path shared by every node,
      // then a fine search near each node's best coarse point. (Sampling every 2px per node was
      // ~20k getPointAtLength calls and froze the page for two seconds as this scrolled in.)
      const COARSE = 24;
      const samples: [number, number, number][] = [];
      for (let l = 0; l <= total; l += COARSE) { const p = path.getPointAtLength(l); samples.push([l, p.x, p.y]); }
      const at: Record<string, number> = {};
      svg.querySelectorAll<SVGGElement>(".snake-node").forEach((node) => {
        const [x, y] = node.getAttribute("transform")!.match(/[\d.]+/g)!.map(Number);
        let best = 0, bestD = Infinity;
        for (const [l, px, py] of samples) { const d = (px - x) ** 2 + (py - y) ** 2; if (d < bestD) { bestD = d; best = l; } }
        const lo = Math.max(0, best - COARSE), hi = Math.min(total, best + COARSE);
        for (let l = lo; l <= hi; l += 2) {
          const p = path.getPointAtLength(l);
          const d = (p.x - x) ** 2 + (p.y - y) ** 2;
          if (d < bestD) { bestD = d; best = l; }
        }
        at[node.dataset.tool!] = best;
      });
      const g = { path, total, at };
      geometry.set(svg, g);
      return g;
    };
    const reset = (svg: SVGSVGElement) => {
      svg.querySelectorAll<SVGGElement>(".snake-node").forEach((n) => { n.classList.remove("trying", "fail", "ok"); n.querySelector(".snake-note")!.textContent = ""; });
      const trail = svg.querySelector<SVGPathElement>(".snake-trail")!;
      const { total } = measure(svg);
      trail.style.strokeDasharray = `${total}`;
      trail.style.strokeDashoffset = `${total}`;
    };
    const mark = (svg: SVGSVGElement, tool: string, outcome: string, note: string) => {
      const node = svg.querySelector<SVGGElement>(`[data-tool="${tool}"]`)!;
      node.classList.remove("trying");
      node.classList.add(outcome);
      node.querySelector(".snake-note")!.textContent = (outcome === "ok" ? "✓ " : "✗ ") + note;
    };
    const finished = () => {
      const svg = visible(); if (!svg) return;
      const read = reads[2];
      reset(svg);
      const { total, at } = measure(svg);
      const last = read.steps[read.steps.length - 1][0];
      read.steps.forEach(([t, o, n]) => mark(svg, t, o, n));
      const trail = svg.querySelector<SVGPathElement>(".snake-trail")!;
      trail.style.strokeDashoffset = `${total - at[last]}`;
      const dot = svg.querySelector<SVGCircleElement>(".snake-dot")!;
      const p = measure(svg).path.getPointAtLength(at[last]);
      dot.setAttribute("cx", String(p.x)); dot.setAttribute("cy", String(p.y));
      urlEl.textContent = `read("${read.url}")`; resultEl.textContent = `→ ${read.result}`;
    };
    if (document.documentElement.dataset.motion === "reduced") { requestAnimationFrame(finished); return; }
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let running = false, onScreen = false;
    const travel = (svg: SVGSVGElement, from: number, to: number) => new Promise<void>((done) => {
      const { path, total } = measure(svg);
      const dot = svg.querySelector<SVGCircleElement>(".snake-dot")!;
      const trail = svg.querySelector<SVGPathElement>(".snake-trail")!;
      const t0 = performance.now(), ms = Math.max(250, Math.abs(to - from) / 0.9);
      const frame = (now: number) => {
        const k = Math.min(1, (now - t0) / ms), e = k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2;
        const l = from + (to - from) * e, p = path.getPointAtLength(l);
        dot.setAttribute("cx", String(p.x)); dot.setAttribute("cy", String(p.y));
        trail.style.strokeDashoffset = `${total - l}`;
        if (k < 1) requestAnimationFrame(frame); else done();
      };
      requestAnimationFrame(frame);
    });
    const play = async () => {
      if (running) return;
      running = true;
      for (let i = 0; onScreen; i = (i + 1) % reads.length) {
        const svg = visible(); if (!svg) break;
        const read = reads[i];
        reset(svg);
        const { at } = measure(svg);
        urlEl.textContent = `read("${read.url}")`; resultEl.textContent = "";
        let here = 0;
        for (const [tool, outcome, note] of read.steps) {
          await travel(svg, here, at[tool]);
          here = at[tool];
          const node = svg.querySelector<SVGGElement>(`[data-tool="${tool}"]`)!;
          node.classList.add("trying");
          await sleep(450);
          mark(svg, tool, outcome, note);
          await sleep(outcome === "ok" ? 300 : 500);
        }
        resultEl.textContent = `→ ${read.result}`;
        await sleep(2400);
      }
      running = false;
    };
    // Measure the path while the browser is idle, well before the figure scrolls into view.
    const warm = () => { const svg = visible(); if (svg) measure(svg); };
    if ("requestIdleCallback" in window) requestIdleCallback(warm, { timeout: 3000 }); else setTimeout(warm, 1200);
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) play();
    }, { threshold: 0.3 }).observe(fig);
  })();

  import { mountSurf } from "../scripts/surf";
  import { mountNav } from "../scripts/nav";
  import { mountPage } from "../scripts/page";

  const canvas = document.getElementById("surf") as HTMLCanvasElement;
  const nav = mountNav();
  mountSurf(canvas, { onStrike: (p) => nav.jolt(p) });
  mountPage();

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => {
    b.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = "Copied"; }
      catch { b.textContent = "Select it"; }
      setTimeout(() => (b.textContent = "Copy"), 1600);
    });
  });
</script>
</body>
</html>
