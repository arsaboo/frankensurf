---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import stitchedWaveMint from "../assets/stitched-wave-mint.svg?url";
import { sources, marquee, walls, toolRows, usRow, cellClass, chipLogos, docsFor, layers, stats, failures, versus, usVersus, usFree, ledger, rungs, searchStats } from "../data/site";

const repo = "https://github.com/yail259/frankensurf";
const half = Math.ceil(marquee.length / 2);
const rowA = marquee.slice(0, half), rowB = marquee.slice(half);
// Marquee rows repeat for the loop; the repeats are hidden from assistive tech and the tab order.
const loop = (row: typeof marquee) => [...row, ...row].map((t, i) => ({ ...t, repeat: i >= row.length, href: docsFor[t.name] }));
// The category chart shows the share read right (higher is better): today = Firecrawl alone,
// target = Frankensurf; site.ts keeps the measured failure shares.
const readRight = failures.map((f) => ({ ...f, today: 100 - f.today, target: 100 - f.target }));
const gap = (f: { today: number; target: number }) => {
  const d = f.target - f.today;
  return Math.abs(d) < 0.05 ? "even" : d > 0 ? `+${d.toFixed(1)} pts` : `−${(-d).toFixed(1)} pts`;
};
const pct = ([v, n]: [number, number]) => (v / n * 100).toFixed(1);
// Every tool on its own, and Frankensurf with and without paid tools, ranked.
const ranked = [
  { name: "Frankensurf", all: usVersus.all, us: true },
  { name: "Frankensurf, free tools only", all: usFree, us: true },
  ...versus.map((t) => ({ name: `${t.name} Only`, all: t.all, us: false })),
].sort((a, b) => b.all[0] / b.all[1] - a.all[0] / a.all[1]);
// The router as a snake: tools in ladder order along one winding path.
const snakeTools = [
  { id: "http", name: "Plain HTTP" }, { id: "jina", name: "Jina Reader" }, { id: "local", name: "Local browser" },
  { id: "camoufox", name: "Camoufox" }, { id: "scrapling", name: "Scrapling" }, { id: "hosted", name: "Hosted browsers", paid: true },
  { id: "firecrawl", name: "Firecrawl", paid: true }, { id: "zyte", name: "Zyte", paid: true }, { id: "you", name: "You", human: true },
];
const snakeLayout = (name: string, perRow: number, cols: number[], rowGap: number, top: number, nw: number, nh: number,
                     turnL: number, turnR: number, w: number) => {
  const rows = Math.ceil(snakeTools.length / perRow);
  const r = rowGap / 2;
  const y = (i: number) => top + i * rowGap;
  const nodes = snakeTools.map((t, i) => {
    const row = Math.floor(i / perRow), k = i % perRow;
    return { ...t, x: row % 2 ? cols[perRow - 1 - k] : cols[k], y: y(row) };
  });
  const start: [number, number] = [14, y(0)];
  let d = `M ${start[0]} ${y(0)}`;
  for (let row = 0; row < rows - 1; row++) {
    const right = row % 2 === 0;
    d += ` H ${right ? turnR : turnL} A ${r} ${r} 0 0 ${right ? 1 : 0} ${right ? turnR : turnL} ${y(row + 1)}`;
  }
  const lastRight = (rows - 1) % 2 === 0;
  const end: [number, number] = [lastRight ? w - 14 : 14, y(rows - 1)];
  d += ` H ${end[0]}`;
  return { name, w, h: y(rows - 1) + nh / 2 + 40, nodes, d, start, end, nw, nh };
};
const snakeLayouts = [
  snakeLayout("wide", 3, [215, 560, 905], 150, 64, 230, 54, 78, 1050, 1130),
  snakeLayout("narrow", 2, [130, 300], 96, 60, 158, 48, 50, 380, 430),
];
const kindLabel = { oss: "Open source", managed: "Managed", standard: "Open standard" };
// Unblockers patch: a short wall across the read's path, with the middle course knocked out.
const bricks = [2, 19, 45, 62].flatMap((y, row) =>
  row % 2 ? [{ x: 100, y, w: 18 }, { x: 122, y, w: 18 }] : [{ x: 100, y, w: 8 }, { x: 112, y, w: 18 }, { x: 134, y, w: 6 }]);

// The plugin rack in #always: what already sits in each slot. Yours bolts on at the end.
const rack = [
  { kind: "Providers", does: "get a page", yours: "my_fetch", mods: [
    { name: "Plain HTTP" }, { name: "Jina Reader" }, { name: "Chromium" }, { name: "Camoufox" },
    { name: "Scrapling" }, { name: "Patchright" }, { name: "Steel", paid: true }, { name: "Firecrawl", paid: true }, { name: "Zyte", paid: true }] },
  { kind: "Search sources", does: "find pages", yours: "my_index", mods: [
    { name: "SearXNG" }, { name: "DuckDuckGo" }, { name: "Google News" }, { name: "Wikipedia" }, { name: "arXiv" }, { name: "Brave", paid: true },
    { name: "Serper", paid: true }, { name: "Exa", paid: true }, { name: "Tavily", paid: true }] },
];
// #agents: one tab per place an agent runs. Code is trusted markup written here.
const fits = [
  { id: "cc", name: "Claude Code", how: "plugin", code: "/plugin marketplace add yail259/frankensurf\n/plugin install frankensurf@frankensurf",
    note: "The MCP server plus a skill that tells Claude when to read, search, try harder or hand you a wall.", href: "/docs/agents/", link: "Claude Code setup" },
  { id: "mcp", name: "Any MCP client", how: "mcp server", code: "frankensurf-mcp",
    note: "Cursor, Codex, Claude Desktop, Windsurf and the rest start the same server.", href: "/docs/agents/", link: "Setup for each client" },
  { id: "lc", name: "LangChain", how: "python", code: '<span class="k">from</span> frankensurf.agent_tools <span class="k">import</span> langchain_tools\n\nagent = create_react_agent(model, langchain_tools())',
    note: "Sync and async tools for LangChain and LangGraph.", href: "/docs/frameworks/", link: "Frameworks" },
  { id: "oa", name: "OpenAI Agents", how: "python", code: '<span class="k">from</span> frankensurf.agent_tools <span class="k">import</span> openai_agents_tools\n\nAgent(name=<span class="s">"researcher"</span>, tools=openai_agents_tools())',
    note: "Strict-schema function tools for the Agents SDK.", href: "/docs/frameworks/", link: "Frameworks" },
  { id: "crew", name: "CrewAI", how: "python", code: '<span class="k">from</span> frankensurf.agent_tools <span class="k">import</span> crewai_tools\n\nAgent(role=<span class="s">"Researcher"</span>, tools=crewai_tools())',
    note: "CrewAI tools with typed arguments.", href: "/docs/frameworks/", link: "Frameworks" },
];
// #agents: every tool the MCP server exposes (src/frankensurf/mcp_server.py), grouped by job.
const agentTools: { group: string; tools: [string, string][] }[] = [
  { group: "Read", tools: [["read", "one page, checked; try_harder_than to go again"], ["batch", "many pages, a receipt each"], ["paginate", "follow next pages under one receipt"], ["extract", "fields with an adapter"], ["images", "exact image URLs, decoded"]] },
  { group: "Search & watch", tools: [["search", "free sources first, results checked"], ["watch_sites", "what's new from feeds and sitemaps"]] },
  { group: "Sites", tools: [["discover_site_module", "learn a site from its own data"], ["site_modules", "save and manage them"], ["read_template", "a saved search URL, filled in"], ["batch_template", "the same, for many queries"], ["repair_site_module", "propose a fix when a site changes"]] },
  { group: "Receipts & repair", tools: [["trace", "what ran, what failed, time and cost"], ["repair", "diagnose a failed read"]] },
  { group: "Signed in", tools: [["do", "one bounded action, with a receipt"], ["identity_status", "health of your saved sessions"], ["profiles", "names and sites, never sessions"], ["import_evidence", "a page you opened yourself"], ["import_image_evidence", "an image you saved yourself"]] },
];
const byName = Object.fromEntries(agentTools.map((g) => [g.group, g]));
const toolCols = [[byName["Read"]], [byName["Sites"]], [byName["Signed in"]], [byName["Search & watch"], byName["Receipts & repair"]]];
// #box: the latest weekly run, benchmarks/weekly/2026-10-13/summary.json (free tools only).
const weekly = [
  { name: "Frankensurf", rate: 81 }, { name: "Jina", rate: 70 }, { name: "Scrapling", rate: 67 }, { name: "Camoufox", rate: 66 }, { name: "HTTP", rate: 44 },
];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Frankensurf</title>
  <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon-stitched-wave.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="description" content="28 web scrapers and browsers stitched into one free, open-source tool for AI agents. 96% of 150 sites picked blind; Firecrawl alone 85%." />
  <script is:inline>
    if (matchMedia("(prefers-reduced-motion: reduce)").matches || new URLSearchParams(location.search).get("motion") === "reduced") document.documentElement.dataset.motion = "reduced";
  </script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<SiteNav home />
<p class="sr-only" id="strike-status" role="status"></p>

<main id="main">
  <section class="hero" id="top">
    <canvas id="surf" aria-label="ASCII art: Frankenstein's monster surfing a barreling wave"></canvas>
    <div class="hero-copy">
      <h1>The <em class="horror">last</em> web tool<br />you&rsquo;ll need.</h1>
      <p class="sub">Because we stitched together the best ones out there: 28 web scrapers and browsers in one free, open-source tool for AI agents.</p>
      <div class="actions">
        <a class="btn primary" href={repo}>Star on GitHub<span class="stars"><span data-stars hidden></span><svg class="star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z" /></svg></span></a>
        <a class="btn" href="#router">See it route</a>
      </div>
      <a class="proof" href="#targets"><span class="claim"><b>96%</b> of 150 sites picked blind</span><span>Firecrawl alone 85% · Zyte alone 86%</span><span class="arrow" aria-hidden="true">↓</span></a>
    </div>
    <p class="hint" aria-hidden="true"><kbd>click</kbd> strike lightning · <kbd>move</kbd> over the water</p>
  </section>

  <section class="marquee-sec" aria-label="Tools Frankensurf is built on">
    <div class="marquee">
      {[loop(rowA), loop(rowB)].map((row, r) => (
        <div class:list={["track", { rev: r === 1 }]}>{row.map((t) => {
          const Tag = t.href ? "a" : "span";
          return <Tag class:list={["logo", { "logo-repeat": t.repeat }]} href={t.href} aria-hidden={t.repeat ? "true" : undefined} tabindex={t.repeat && t.href ? -1 : undefined}><img src={`/logos/${t.logo}`} alt="" width="22" height="22" loading="lazy" />{t.name}</Tag>;
        })}</div>
      ))}
    </div>
  </section>

  <section class="container window-wrap" id="router">
    <div class="window" data-router>
      <div class="w-bar">
        <div class="w-dots"><i></i><i></i><i></i></div>
        <span class="w-title">router</span>
        <div class="seg" data-providers role="group" aria-label="Model provider"></div>
      </div>
      <div class="w-body">
        <div class="w-left">
          <span class="label">your agent</span>
          <pre class="code" data-code></pre>
          <div class="native" data-native></div>
        </div>
        <div class="w-right">
          <span class="label">frankensurf</span>
          <ol class="ladder" data-ladder></ol>
        </div>
      </div>
      <div class="w-foot">
        <div class="seg" data-sites role="group" aria-label="Page type"></div>
        <div class="summary" data-summary role="status"></div>
      </div>
    </div>
  </section>

  <section class="container sec" id="targets">
    <div class="sec-head" data-reveal>
      <h2>96% of sites. Picked <em class="horror">blind.</em></h2>
      <p class="sec-sub">150 sites picked before any was read and read once: every tool on its own, then Frankensurf, the same day, the same content checks (11 October 2026). Frankensurf read 17 sites Firecrawl missed; Firecrawl read none it missed. With no paid tools at all, it matches the best paid tool on its own. Its median read took 2.9 s against Firecrawl's 4.6 s; its slowest tenth still takes longer, 26 s against 11 s.</p>
    </div>
    <div class="panel rank" data-reveal role="list" aria-label="Share of 150 sites read right, each tool on its own and Frankensurf">
      {ranked.map((r, i) => (
        <div class:list={["rank-row", { us: r.us }]} role="listitem">
          <span class="lbl">{r.name}</span>
          <span class="rank-track" aria-hidden="true"><i style={`--w:${pct(r.all)}%;--i:${i}`}></i></span>
          <span class="val">{pct(r.all)}%</span>
        </div>
      ))}
      <a class="bars-src" href={sources.bench.url}>Sites read right, of 150 · raw rows and script ↗</a>
    </div>
    <h3 class="sec-h3" data-reveal>Ahead or level in every category.</h3>
    <div class="stats" data-reveal>
      {stats.map((s) => <div class="stat"><span class="v">{s.value}</span><span class="l">{s.label}</span><span class="n">{s.note}</span></div>)}
    </div>
    <div class="panel bars" data-reveal>
      <div class="bars-key"><span class="kt">Firecrawl Only</span><span class="kg">Frankensurf</span><a class="bars-src" href={sources.bench.url}>Share of 150 sites read right · source ↗</a></div>
      {readRight.map((f) => (
        <div class="bar-row">
          <span class="lbl">{f.label}</span>
          <div class="track2">
            <div class="t"><i style={`--w:${f.today}%`}></i><span>{f.today.toFixed(1)}%</span></div>
            <div class="g"><i style={`--w:${f.target}%`}></i><span>{f.target.toFixed(1)}%</span></div>
          </div>
          <span class:list={["cut", { worse: f.target < f.today - 0.05 }]}>{gap(f)}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="container sec" id="versus">
    <div class="sec-head" data-reveal>
      <h2>Stronger <em class="horror">stitched.</em></h2>
      <p class="sec-sub">Measured 11 October 2026. Frankensurf against each of its own providers used on its own, on the same 150 sites picked before any was read, the same day.</p>
    </div>
    <div class="panel vs" data-versus data-reveal>
      <div class="vs-tabs" role="tablist" aria-label="Frankensurf compared with one provider on its own">
        {versus.map((t, i) => <button type="button" role="tab" id={`vs-tab-${i}`} aria-controls={`vs-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}><img src={`/logos/${t.logo}`} alt="" width="20" height="20" loading="lazy" /><span>{t.name} Only</span><i></i></button>)}
      </div>
      {versus.map((t, i) => (
        <div class="vs-slide" role="tabpanel" id={`vs-${i}`} aria-labelledby={`vs-tab-${i}`} hidden={i !== 0}>
          <div class="vs-score">
            <div class="vs-side us"><span class="vs-v">{pct(usVersus.all)}%</span><span class="vs-n"><img class="fs" src={stitchedWaveMint} alt="" width="20" height="20" />Frankensurf</span></div>
            <span class="vs-mid" aria-hidden="true">vs</span>
            <div class="vs-side"><span class="vs-v">{pct(t.all)}%</span><span class="vs-n"><img src={`/logos/${t.logo}`} alt="" width="20" height="20" loading="lazy" />{t.name} Only</span></div>
          </div>
          <p class="vs-cap">of 150 fresh sites read right</p>
          <dl class="vs-rows">
            <div><dt>Of sites any tool could read</dt><dd class:list={{ lose: t.unseen > usVersus.unseen }}>{usVersus.unseen.toFixed(1)}% vs {t.unseen.toFixed(1)}%</dd></div>
            <div><dt>Cost per 1,000 pages read</dt><dd>{usVersus.cost} vs {t.cost}</dd></div>
          </dl>
        </div>
      ))}
    </div>
  </section>

  <section class="container sec" id="search">
    <div class="sec-head" data-reveal>
      <h2><em class="horror">Search,</em> checked.</h2>
      <p class="sec-sub">Every result checked: on topic, the right kind of page, inside your date window. Judged blind on 240 fresh queries by reviewers who never saw which tool found what. Free, it beats Firecrawl&rsquo;s search; with paid allowed, it&rsquo;s level with Exa.</p>
    </div>
    <div class="stats stats-3" data-reveal>
      {searchStats.map((s) => <div class="stat"><span class="v">{s.value}</span><span class="l">{s.label}</span><span class="n">{s.note}</span></div>)}
    </div>
    <a class="bars-src" href="https://github.com/yail259/frankensurf/tree/main/benchmarks/2026-10-13-search" data-reveal>Every verdict, the queries and the scripts ↗</a>
  </section>

  <section class="container sec" id="problem">
    <div class="sec-head" data-reveal>
      <h2>Every tool <em class="horror">breaks</em> somewhere.</h2>
    </div>
    <div class="panel" data-reveal>
      <div class="matrix" role="region" aria-label="Tool capability comparison" tabindex="0">
        <table>
          <thead><tr><th scope="col"><span class="sr-only">Approach</span></th>{walls.map((w) => <th scope="col">{w}</th>)}</tr></thead>
          <tbody>
            {toolRows.map((r) => (
              <tr><th scope="row">{r.name}</th>{r.cells.map((c) => <td title={`${c.v} of ${c.n} pages read right`}><span class={`d ${cellClass(c)}`} role="img" aria-label={`${Math.round(c.v / c.n * 100)}%`}></span><span class="pct">{Math.round(c.v / c.n * 100)}%</span></td>)}</tr>
            ))}
            <tr class="us"><th scope="row">Frankensurf</th>{usRow.map((c, i) => <td title={`${c.v} of ${c.n} pages read right`}><span class={`d ${cellClass(c)}`} style={`--i:${i}`} role="img" aria-label={`${Math.round(c.v / c.n * 100)}%`}></span><span class="pct">{Math.round(c.v / c.n * 100)}%</span></td>)}</tr>
          </tbody>
        </table>
      </div>
      <div class="legend"><span><i class="d o"></i>80%+ read right</span><span><i class="d p"></i>40–79%</span><span><i class="d x"></i>under 40%</span><span>Measured 6 Oct 2026 on 127 pages. Single tools read logged-in pages without your session.</span></div>
    </div>
    <div class="facts">
      <a class="panel fact" href={sources.fcclaude.url} data-spot data-reveal><b>Native fetch skips JavaScript</b><span class="src">Firecrawl ↗</span></a>
      <a class="panel fact" href={sources.omega.url} data-spot data-reveal><b>Cloudflare blocks agents by default</b><span class="src">O-mega ↗</span></a>
      <a class="panel fact" href={sources.egotok.url} data-spot data-reveal><b>Snapshots burn 114k tokens a task</b><span class="src">ego.app ↗</span></a>
    </div>
  </section>

  <section class="container sec" id="how">
    <div class="sec-head" data-reveal>
      <h2>Capability first. Cost <em class="horror">aware.</em></h2>
    </div>
    <figure class="snake" data-snake data-reveal>
      {snakeLayouts.map((L) => (
        <svg class:list={["snake-svg", L.name]} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-label="How Frankensurf routes a read: the request travels a path of tools in order, cheapest first. Plain HTTP, Jina Reader, a local browser, Camoufox and Scrapling are free; hosted browsers, Firecrawl and Zyte are paid and only used if you allow them; the last stop is you, for a CAPTCHA or 2FA. Each read stops at the first tool that returns the real page.">
          <path class="snake-path" d={L.d} />
          <path class="snake-trail" d={L.d} />
          <text class="snake-end" x={L.start[0]} y={L.start[1] - 26}>read(url)</text>
          <circle class="snake-start" cx={L.start[0]} cy={L.start[1]} r="5" />
          <text class="snake-end" x={L.end[0]} y={L.end[1] - 26} text-anchor="end">the page</text>
          <path class="snake-arrow" d={`M ${L.end[0] - 9} ${L.end[1] - 6} L ${L.end[0]} ${L.end[1]} L ${L.end[0] - 9} ${L.end[1] + 6}`} />
          <circle class="snake-dot" r="7" cx={L.start[0]} cy={L.start[1]} />
          {L.nodes.map((n) => (
            <g class:list={["snake-node", { paid: n.paid, human: n.human }]} data-tool={n.id} transform={`translate(${n.x} ${n.y})`}>
              <rect x={-L.nw / 2} y={-L.nh / 2} width={L.nw} height={L.nh} rx="12" />
              <text class="snake-name" x={-L.nw / 2 + 14} y="5">{n.name}</text>
              <text class="snake-cost" x={L.nw / 2 - 14} y="5" text-anchor="end">{n.human ? "opt-in" : n.paid ? "paid" : "free"}</text>
              <text class="snake-note" x="0" y={L.nh / 2 + 18} text-anchor="middle"></text>
            </g>
          ))}
        </svg>
      ))}
      <figcaption class="snake-caption" aria-live="off"><code data-snake-url>read("walmart.com/search?q=air+fryer")</code><span data-snake-result>→ the page via Camoufox · 3 tried · free</span></figcaption>
      <p class="snake-legend"><span class="lg-free">free</span><span class="lg-paid">paid, only if you allow it</span><span class="lg-you">you, only if you allow it</span></p>
    </figure>

    <div class="how">
      <div class="panel" data-spot data-reveal>
        <div class="mini-rungs">
          {rungs.map((r, i) => <div><span>{r.id}</span><i style={`--w:${Math.max(4, r.share / 40 * 100)}%;--i:${i}`}></i><span>{r.share}%</span></div>)}
        </div>
        <h3>40% never open a browser</h3>
      </div>
      <div class="panel" data-spot data-reveal>
        <div class="cache">
          <div>docs.acme.dev <span class="chip-r">T0</span></div>
          <div>app.acme.dev <span class="chip-r">T2</span></div>
          <div>shop.example.com <span class="chip-r">T3</span></div>
          <div>retail.example.com <span class="chip-r">T4</span></div>
        </div>
        <h3>It remembers what worked</h3>
      </div>
      <div class="panel" data-spot data-reveal>
        <div class="notif">
          <div class="notif-top"><span class="ic">FS</span>Approval needed<small>now</small></div>
          <p>Your agent reached a 2FA prompt on bank.example.com.</p>
          <div class="notif-act"><span>Approve</span><span>Decline</span></div>
        </div>
        <h3>Walls it can't pass come to you</h3>
      </div>
    </div>
  </section>

  <section class="container sec" id="parts">
    <div class="sec-head" data-reveal>
      <h2>We <em class="horror">stitch.</em> We don't reinvent.</h2>
    </div>
    <div class="bento">
      {layers.map((l) => (
        <div class="patch" data-spot data-reveal>
          {/* One drawing language: grey hairlines and boxes, one green element for the outcome.
              Each reads complete when still; motion only runs along the green path. */}
          <svg class={`viz v-${l.key}`} viewBox="0 0 240 76" aria-hidden="true">
            {l.key === "provider" && <>
              {[8, 28, 48, 68].map((y) => <><circle class="node" cx="6" cy={y} r="3.5" /><path class="wire" d={`M10 ${y} C 60 ${y}, 64 38, 98 38`} /></>)}
